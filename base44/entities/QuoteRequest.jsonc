{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telephone": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Netherlands"
    },
    "delivery_address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "preferred_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "transport_required": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ]
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "In Progress",
        "Quoted",
        "Accepted",
        "Declined"
      ],
      "default": "New"
    }
  },
  "required": [
    "customer_name",
    "email",
    "telephone"
  ]
}